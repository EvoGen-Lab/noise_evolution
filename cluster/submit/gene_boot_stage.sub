#!/bin/sh -l
# FILENAME:  gene_boot_stage.sbatch
#
# Later stages of the staged bootstrap (Methods: Bootstrap tests of significance), one job array over gene blocks per stage:
#   stage 3: 10,000 fresh replicates for the genes whose 1,000-replicate p-values left n0 < 40 in a family
#   stage 4: 100,000 fresh replicates for the genes whose stage-3 p-values left n0 < 50 in a family
#   stage 5: 100,000 replicates of the degrees of dominance k_P and k_T for the genes they class, at the false coverage-statement level
# Submit each after analysis.R Section 2.3 has written gene_stage<s>_inputs.rda, with the stage and the number of gene blocks (N.STAGE.ARRAY) set:
#   sbatch --export=ALL,GENE_BOOT_STAGE=3 --array=1-20 gene_boot_stage.sub
# Task k writes gene_boot_stage<s>_output_<k>of<K>.rda; resubmitting the array recomputes only the missing blocks. gene_boot.R checks that --array
# matches N.STAGE.ARRAY in its inputs. A replicate refits 18 datasets (about 40 ms at 2,500 cells), so 100,000 replicates take about an hour per gene and
# core; raise --time or the number of blocks with the number of genes the stage holds.

#SBATCH --account=bphm
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --partition=cpu
#SBATCH --cpus-per-task=24
#SBATCH --qos=normal
#SBATCH --time=24:00:00
#SBATCH --job-name gene_boot_stage
#SBATCH --output=gene_boot_stage_%A_%a.out

module load r/4.5.2

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

if [ -z "$GENE_BOOT_STAGE" ]; then echo "set GENE_BOOT_STAGE to 3, 4 or 5 (sbatch --export=ALL,GENE_BOOT_STAGE=3 ...)"; exit 1; fi
Rscript gene_boot.R
