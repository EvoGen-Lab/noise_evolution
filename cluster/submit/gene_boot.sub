#!/bin/sh -l
# FILENAME:  gene_boot.sbatch
#
# First stage of the staged bootstrap (Methods: Bootstrap tests of significance), 1,000 replicates per gene, unshifted, as a job
# array: task k bootstraps seed replicate k (draw plan seed SEED.BOOT + k - 1) and writes gene_boot_output_<k>of<K>.rda. Replicate 1
# is the first stage; the others check seed adequacy. Resubmitting the array recomputes only the replicates whose output file is
# missing. gene_boot.R checks that --array matches the number of seed replicates in its inputs. Stage 2 is gene_boot_shift.sub,
# stages 3 to 5 gene_boot_stage.sub.

#SBATCH --account=bphm
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --partition=cpu
#SBATCH --cpus-per-task=24
#SBATCH --qos=normal
#SBATCH --time=1:30:00
#SBATCH --job-name gene_boot
#SBATCH --array=1-2
#SBATCH --output=gene_boot_%A_%a.out

module load r/4.5.2

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

Rscript gene_boot.R