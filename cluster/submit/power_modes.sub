#!/bin/sh -l
# FILENAME:  power_modes.sub
#
# Cis and trans power grid on paired-allele hybrid data: the rows of GRID (mean reads x size x phi x f x design x
# depth ratio) dealt round-robin across the array tasks. Each row simulates every SIZE.RATIO value, the cis
# contrast and the trans contrast, each tested on the mean and the dispersion by the bootstrap sign test. Each task
# requests 1 node and 24 cores.
#
# Sizing. The reduced grid defined in power_analysis.R Section 10.9 has 112 rows, NJ = 200 datasets and NI = 2000
# bootstrap replicates per dataset (NI sets the smallest p-value, 2 / (NI + 1), which BH power needs to resolve). Each
# replicate refits 4 groups once per dataset and 2 groups per SIZE.RATIO value, fewer fits than the earlier permutation
# nulls (10 per permutation), whose rows took about 3.5 core-hours; the sign-test version has not been timed, so the
# earlier --time is kept as an upper bound. A full grid scales with the number of rows, NJ and NI.
#
# Restarts. A task writes its output file only when it finishes. Resubmitting the array
# recomputes only the tasks whose power_modes_output_<k>of<K>.rda is missing; a task stopped at the
# time limit starts over.

#SBATCH --account=bphm
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --partition=cpu
#SBATCH --cpus-per-task=24
#SBATCH --qos=normal
#SBATCH --time=1-00:00:00
#SBATCH --job-name power_modes
#SBATCH --array=1-4
#SBATCH --output=power_modes_%A_%a.out

module load r/4.5.2

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

Rscript power_modes_grid.R
