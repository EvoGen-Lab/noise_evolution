#!/bin/sh -l
# FILENAME:  artefact_null.sbatch
#
# Simulation arm of the tests of why the data depart from the NB (T0, T8, T12): gene chunks of the gene-matched NB null (200 replicates per gene and
# group) and the simulated datasets of the null-divergence and artefact scenarios, dealt round-robin across the array tasks.
#
# Sizing. T0 refits each replicate about seven times (all cells, trimmed, three depth terciles, thinned) on 4536 genes x 4 groups x 200 replicates,
# about 25 million fits of 1 to 3 ms, plus the T4 and T11 nulls on the first replicates: roughly 30 core-hours. The 26 scenario datasets fit every
# gene about 12 times each: under 10 core-hours. With 8 tasks of 24 cores the array finishes in a few hours; the time limit allows a large margin.
# artefact_null_grid.R reads the task count from SLURM_ARRAY_TASK_COUNT, so changing --array needs no other edit.
#
# Restarts. A task writes its output file only when it finishes; resubmitting recomputes only the missing files.
#
# Files next to this script: functions.R, functions_checks.R, functions_artefacts.R, artefact_null_grid.R, artefact_inputs.rda.

#SBATCH --account=bphm
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --partition=cpu
#SBATCH --cpus-per-task=24
#SBATCH --qos=normal
#SBATCH --time=1-00:00:00
#SBATCH --job-name artefact
#SBATCH --array=1-8
#SBATCH --output=artefact_%A_%a.out

module load r/4.5.2

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

Rscript artefact_null_grid.R
